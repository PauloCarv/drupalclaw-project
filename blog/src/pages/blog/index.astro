---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { getPosts } from '../../lib/posts';

const posts = await getPosts();
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<a href="#main" class="skip-link">Skip to content</a>
		<Header />
		<main id="main" tabindex="-1">
			<h1>Articles</h1>
			<ul class="post-list">
				{posts.map((post) => (
					<li>
						<a href={`/blog/${post.id}/`} class="post-card">
							<span class="post-meta">
								{post.data.tag && <span class="post-tag">{post.data.tag}</span>}
								<span class="post-date"><FormattedDate date={post.data.pubDate} /></span>
								<span class="post-date">{post.readingTime} min read</span>
							</span>
							<h2>{post.data.title}</h2>
							<p>{post.data.description}</p>
							<span class="read-more">Read article →</span>
						</a>
					</li>
				))}
			</ul>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: 1100px;
		max-width: calc(100% - 2em);
		margin: 0 auto;
		padding: 3em 1em 4em;
	}
	h1 {
		font-size: 2em;
		margin: 0 auto 1.25em;
		max-width: var(--column);
	}
	.post-list {
		list-style: none;
		padding: 0;
		margin: 0 auto;
		max-width: var(--column);
		display: flex;
		flex-direction: column;
		gap: 0.75em;
	}
	.post-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5em 1em;
	}
	.post-tag {
		padding: 0.1em 0.7em;
		border: 1px solid var(--border-strong);
		border-radius: 100px;
		font-size: 0.74em;
		color: var(--link);
	}
	.post-card {
		display: flex;
		flex-direction: column;
		gap: 0.5em;
		padding: 1.75em 2em;
		background: #111827;
		border: 1px solid #1a2035;
		border-radius: 10px;
		color: inherit;
		transition: border-color 0.15s, box-shadow 0.15s, background 0.15s;
	}
	.post-card:hover {
		border-color: #0678be;
		background: #131e30;
		box-shadow: 0 0 0 1px rgba(6, 120, 190, 0.15), 0 4px 16px rgba(6, 120, 190, 0.08);
		color: inherit;
	}
	.post-date {
		font-size: 0.78em;
		color: var(--text-soft);
		letter-spacing: 0.02em;
	}
	.post-card h2 {
		margin: 0;
		font-size: 1.35em;
		color: #fff;
		line-height: 1.3;
	}
	.post-card p {
		margin: 0;
		font-size: 0.98em;
		color: #8899b8;
		line-height: 1.6;
	}
	.read-more {
		font-size: 0.82em;
		color: #0e90d9;
		margin-top: 0.25em;
		font-weight: 500;
	}
	.post-card:hover .read-more {
		color: #2dd4bf;
	}
</style>
