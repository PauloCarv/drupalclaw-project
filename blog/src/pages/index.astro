---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getPosts } from '../lib/posts';

const posts = await getPosts();
const [featured, ...others] = posts;
const REPO = 'https://github.com/PauloCarv/drupalclaw-project';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<a href="#main" class="skip-link">Skip to content</a>
		<Header />

		<main id="main" tabindex="-1">
			<section class="hero wrap">
				<div class="hero-copy">
					<p class="eyebrow">Open source · Self-hosted · AI-first</p>
					<h1>Agent-first Drupal development.</h1>
					<p class="hero-text">
						A self-hosted workspace where an AI agent scaffolds, serves and debugs your Drupal project,
						and shows you the commands it ran so you learn as it works.
					</p>
					<div class="cta">
						<a href={REPO} class="btn btn-primary" target="_blank" rel="noopener noreferrer">★ Star on GitHub</a>
						{featured && <a href={`/blog/${featured.id}/`} class="btn btn-ghost">Read the latest update →</a>}
					</div>
				</div>
				<div class="hero-mark">
					<div class="glow">
						<img src="/logo.png" alt="DrupalClaw logo: a claw holding the Drupal drop" width="300" height="300" />
					</div>
				</div>
			</section>

			<section class="glance" aria-label="At a glance">
				<div class="wrap glance-grid">
					<div>
						<p class="label">Skills</p>
						<p class="glance-title">24 Drupal workflows</p>
						<p class="glance-note">From drupal-init to PHPStan, plus a Marketplace for your own.</p>
					</div>
					<div>
						<p class="label">Providers</p>
						<p class="glance-title">Copilot, OpenAI, Anthropic</p>
						<p class="glance-note">Bring the subscription you already have.</p>
					</div>
					<div>
						<p class="label">Runtime</p>
						<p class="glance-title">Local, in Docker</p>
						<p class="glance-note">Your code stays on your machine.</p>
					</div>
					<div>
						<p class="label">Modes</p>
						<p class="glance-title">Learning or Expert</p>
						<p class="glance-note">Get the result, or the result plus how to do it by hand.</p>
					</div>
				</div>
			</section>

			<section class="wrap writing">
				<div class="section-head">
					<h2>Latest writing</h2>
					<a href="/blog" class="more">All articles →</a>
				</div>

				{featured && (
					<a href={`/blog/${featured.id}/`} class="featured">
						<div class="featured-art" aria-hidden="true">
							<img src="/logo.png" alt="" width="120" height="120" />
						</div>
						<div class="featured-body">
							<p class="meta">
								{featured.data.tag && <span class="tag">{featured.data.tag}</span>}
								<span><FormattedDate date={featured.data.pubDate} /></span>
								<span>{featured.readingTime} min read</span>
							</p>
							<h3>{featured.data.title}</h3>
							<p class="featured-desc">{featured.data.description}</p>
							<span class="read-more">Read article →</span>
						</div>
					</a>
				)}

				{others.map((post) => (
					<a href={`/blog/${post.id}/`} class="card">
						<p class="meta">
							{post.data.tag && <span class="tag">{post.data.tag}</span>}
							<span><FormattedDate date={post.data.pubDate} /></span>
							<span>{post.readingTime} min read</span>
						</p>
						<h3>{post.data.title}</h3>
						<p class="card-desc">{post.data.description}</p>
					</a>
				))}
			</section>

			<section class="wrap recognition" aria-label="Recognition">
				<a
					href="https://www.thedroptimes.com/interview/71976/drupalclaw-agent-first-development-boundaries"
					class="panel panel-link"
					target="_blank"
					rel="noopener noreferrer"
				>
					<p class="label">Featured in</p>
					<p class="panel-title">The Drop Times</p>
					<p class="panel-note">Interview: agent-first development and its boundaries ↗</p>
				</a>
				<div class="panel">
					<p class="label">Recognition</p>
					<p class="panel-title">2nd place · GenAI QuickWins</p>
					<p class="panel-note">NTT DATA internal challenge, 2026</p>
				</div>
			</section>

			<section class="wrap follow">
				<div class="follow-box">
					<div>
						<h2>Follow the build</h2>
						<p>New posts land in the RSS feed. Releases and changelogs live on GitHub.</p>
					</div>
					<div class="cta">
						<a href="/rss.xml" class="btn btn-ghost">Subscribe via RSS</a>
						<a href={`${REPO}/releases`} class="btn btn-primary" target="_blank" rel="noopener noreferrer">Watch releases</a>
					</div>
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	main {
		width: 100%;
		max-width: none;
		padding: 0;
	}

	.wrap {
		max-width: 1200px;
		margin: 0 auto;
		padding-left: 24px;
		padding-right: 24px;
	}

	.label {
		margin: 0 0 0.4em;
		font-family: var(--font-mono), monospace;
		font-size: 0.72em;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: #8899b8;
	}
	.btn {
		display: inline-flex;
		align-items: center;
		min-height: 48px;
		padding: 0 22px;
		border-radius: 6px;
		font-size: 1em;
		transition: background 0.15s, border-color 0.15s;
	}
	.btn-primary {
		background: var(--accent);
		color: #fff;
		font-weight: 700;
	}
	.btn-primary:hover {
		background: #0e90d9;
		color: #fff;
	}
	.btn-ghost {
		border: 1px solid var(--border-strong);
		color: var(--text-primary);
	}
	.btn-ghost:hover {
		border-color: #8899b8;
		color: #fff;
	}
	.cta {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
	}

	.hero {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(460px, 100%), 1fr));
		gap: 48px;
		align-items: center;
		padding-top: clamp(40px, 7vw, 72px);
		padding-bottom: clamp(40px, 6vw, 64px);
	}
	.hero-copy {
		display: flex;
		flex-direction: column;
		gap: 24px;
	}
	.hero-copy > * { margin: 0; }
	.eyebrow {
		font-family: var(--font-mono), monospace;
		font-size: 0.72em;
		letter-spacing: 0.04em;
		color: var(--accent-teal);
	}
	.hero h1 {
		margin: 0;
		font-size: clamp(2.5rem, 5.2vw, 4.25rem);
		line-height: 1.04;
		letter-spacing: -0.02em;
		text-wrap: balance;
		color: #fff;
	}
	.hero-text {
		max-width: 34em;
		font-size: 1.1em;
		color: var(--text-soft);
		text-wrap: pretty;
	}
	.hero-mark {
		display: flex;
		justify-content: center;
	}
	.glow {
		width: min(380px, 80vw);
		aspect-ratio: 1;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		background: radial-gradient(circle, rgba(6, 120, 190, 0.28) 0%, rgba(6, 120, 190, 0) 68%);
	}
	.glow img {
		width: 72%;
		height: 72%;
		object-fit: contain;
		border-radius: 0;
	}

	.glance {
		border-top: 1px solid var(--border);
		border-bottom: 1px solid var(--border);
		background: #0d1220;
	}
	.glance-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr));
		gap: 28px;
		padding-top: 32px;
		padding-bottom: 32px;
	}
	.glance-grid p { margin: 0; }
	.glance-title {
		font-size: 1.1em;
		font-weight: 700;
		color: #fff;
	}
	.glance-note {
		margin-top: 0.3em !important;
		font-size: 0.83em;
		line-height: 1.5;
		color: var(--text-soft);
	}

	.writing {
		display: flex;
		flex-direction: column;
		gap: 20px;
		padding-top: 72px;
		padding-bottom: 24px;
	}
	.section-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 16px;
		margin-bottom: 8px;
	}
	.section-head h2 {
		margin: 0;
		font-size: 1.75em;
		line-height: 1.2;
		color: #fff;
	}
	.more {
		padding: 10px 0;
		color: var(--link);
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 6px 12px;
		margin: 0;
		font-family: var(--font-mono), monospace;
		font-size: 0.72em;
		color: #8899b8;
	}
	.tag {
		padding: 2px 10px;
		border: 1px solid rgba(79, 176, 236, 0.45);
		border-radius: 999px;
		color: var(--link);
	}

	.featured {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(420px, 100%), 1fr));
		overflow: hidden;
		background: var(--navy-800);
		border: 1px solid var(--border);
		border-radius: 12px;
		color: inherit;
		transition: border-color 0.15s;
	}
	.featured:hover,
	.card:hover { border-color: var(--accent); color: inherit; }
	.featured-art {
		min-height: 260px;
		display: flex;
		align-items: center;
		justify-content: center;
		background-color: #0d1424;
		background-image:
			linear-gradient(#1a2035 1px, transparent 1px),
			linear-gradient(90deg, #1a2035 1px, transparent 1px);
		background-size: 28px 28px;
	}
	.featured-art img { border-radius: 0; }
	.featured-body {
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 14px;
		padding: 32px;
	}
	.featured-body h3 {
		margin: 0;
		font-size: 1.65em;
		line-height: 1.2;
		color: #fff;
		text-wrap: balance;
	}
	.featured-desc,
	.card-desc {
		margin: 0;
		color: var(--text-soft);
		text-wrap: pretty;
	}
	.read-more { color: var(--link); }

	.card {
		display: flex;
		flex-direction: column;
		gap: 10px;
		padding: 28px 32px;
		background: var(--navy-800);
		border: 1px solid var(--border);
		border-radius: 12px;
		color: inherit;
		transition: border-color 0.15s;
	}
	.card h3 {
		margin: 0;
		font-size: 1.35em;
		line-height: 1.25;
		color: #fff;
	}

	.recognition {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(360px, 100%), 1fr));
		gap: 16px;
		padding-top: 48px;
		padding-bottom: 48px;
	}
	.panel {
		padding: 24px 28px;
		border: 1px solid var(--border);
		border-radius: 12px;
		color: inherit;
	}
	.panel p { margin: 0; }
	.panel-link { transition: border-color 0.15s; }
	.panel-link:hover { border-color: var(--accent); color: inherit; }
	.panel-title {
		font-size: 1.1em;
		font-weight: 700;
		color: #fff;
	}
	.panel-note {
		margin-top: 0.4em !important;
		font-size: 0.83em;
		color: var(--text-soft);
	}

	.follow {
		padding-top: 24px;
		padding-bottom: 88px;
	}
	.follow-box {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		padding: 40px;
		background: var(--navy-800);
		border: 1px solid var(--border);
		border-radius: 16px;
	}
	.follow-box h2 {
		margin: 0 0 0.3em;
		font-size: 1.55em;
		line-height: 1.2;
		color: #fff;
	}
	.follow-box p {
		margin: 0;
		max-width: 36em;
		color: var(--text-soft);
	}
</style>
