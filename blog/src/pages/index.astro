---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getPosts } from '../lib/posts';

const posts = await getPosts();
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<a href="#main" class="skip-link">Skip to content</a>
		<Header />

		<section class="hero">
			<div class="hero-inner">
				<div class="hero-mark">
					<img src="/logo.png" alt="" width="260" height="260" />
				</div>
				<div class="hero-copy">
					<h1>Drupal<span>Claw</span></h1>
					<p class="hero-tagline">An agent-first Drupal development environment</p>
					<p class="hero-text">
						Self-hosted in Docker. Scaffold, serve and debug Drupal with an AI agent that does the work
						and teaches as it goes.
					</p>
					<ul class="hero-pills">
						<li>Drupal skills</li>
						<li>Self-hosted</li>
						<li>Multi-LLM</li>
						<li>Flows &amp; Plans</li>
						<li>Open source</li>
					</ul>
					<div class="hero-cta">
						<a href="https://github.com/PauloCarv/drupalclaw-project" class="btn-primary" target="_blank" rel="noopener noreferrer">
							★ Star on GitHub
						</a>
						<a href="/blog" class="btn-ghost">Read the blog →</a>
					</div>
				</div>
			</div>
		</section>

		<main id="main" tabindex="-1">
			<section class="posts-section">
				<h2 class="section-label">Latest articles</h2>
				<ul class="post-list">
					{posts.map((post) => (
						<li>
							<a href={`/blog/${post.id}/`} class="post-card">
								<span class="post-meta">
									{post.data.tag && <span class="post-tag">{post.data.tag}</span>}
									<span class="post-date"><FormattedDate date={post.data.pubDate} /></span>
									<span class="post-date">{post.readingTime} min read</span>
								</span>
								<h3>{post.data.title}</h3>
								<p>{post.data.description}</p>
								<span class="read-more">Read article →</span>
							</a>
						</li>
					))}
				</ul>
				{posts.length === 0 && (
					<p class="empty">No articles yet. Check back soon.</p>
				)}
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	.hero {
		background:
			radial-gradient(60% 80% at 20% 50%, rgba(6, 120, 190, 0.18), transparent 70%),
			radial-gradient(50% 70% at 90% 10%, rgba(45, 212, 191, 0.08), transparent 70%),
			#0a0e1a;
		border-bottom: 1px solid #1a2035;
	}
	.hero-inner {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
		align-items: center;
		gap: clamp(1.5rem, 5vw, 4rem);
		max-width: 1100px;
		margin: 0 auto;
		padding: clamp(2.5rem, 7vw, 5.5rem) 1.5em;
	}
	.hero-mark {
		display: flex;
		justify-content: center;
	}
	.hero-mark img {
		width: clamp(11rem, 26vw, 17rem);
		height: auto;
		border-radius: 0;
		filter: drop-shadow(0 0 40px rgba(6, 120, 190, 0.35));
	}
	.hero-copy h1 {
		margin: 0;
		font-size: clamp(2.75rem, 7vw, 4.5rem);
		line-height: 1;
		letter-spacing: -0.03em;
		color: #fff;
	}
	.hero-copy h1 span { color: #1e90f0; }
	.hero-tagline {
		margin: 0.6em 0 0.4em;
		font-size: clamp(1.15rem, 2.4vw, 1.5rem);
		font-weight: 700;
		color: #8ec5f2;
	}
	.hero-text {
		max-width: 34rem;
		margin: 0 0 1.25em;
		color: var(--text-soft);
		line-height: 1.6;
	}
	.hero-pills {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5em;
		margin: 0 0 1.75em;
		padding: 0;
	}
	.hero-pills li {
		display: flex;
		align-items: center;
		gap: 0.5em;
		padding: 0.3em 0.9em;
		background: rgba(255, 255, 255, 0.04);
		border: 1px solid var(--border-strong);
		border-radius: 100px;
		font-family: var(--font-mono), monospace;
		font-size: 0.8em;
		color: #d4dded;
	}
	.hero-pills li::before {
		content: '';
		width: 0.5em;
		height: 0.5em;
		border-radius: 50%;
		background: var(--accent-teal);
	}
	.hero-cta {
		display: flex;
		gap: 0.75em;
		flex-wrap: wrap;
	}
	.btn-primary {
		background: #0678be;
		color: #fff;
		padding: 0.5em 1.25em;
		border-radius: 6px;
		font-weight: 600;
		font-size: 0.88em;
		transition: background 0.15s;
	}
	.btn-primary:hover {
		background: #0e90d9;
		color: #fff;
	}
	.btn-ghost {
		background: transparent;
		color: #8899b8;
		padding: 0.5em 1.25em;
		border-radius: 6px;
		border: 1px solid #667aa3;
		font-size: 0.88em;
		transition: border-color 0.15s, color 0.15s;
	}
	.btn-ghost:hover {
		color: #e2e8f4;
		border-color: #8899b8;
	}

	main {
		width: 1100px;
		max-width: calc(100% - 2em);
		margin: 0 auto;
		padding: 3em 1em 4em;
	}

	.section-label {
		font-size: 0.75em;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: #7c8db0;
		font-weight: 600;
		margin-bottom: 1.5em;
	}

	.post-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 1px;
	}
	.post-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5em 1em;
	}
	.post-tag {
		padding: 0.1em 0.7em;
		border: 1px solid var(--border-strong);
		border-radius: 100px;
		font-size: 0.74em;
		color: var(--link);
	}
	.post-card {
		display: flex;
		flex-direction: column;
		gap: 0.5em;
		padding: 2em 2.25em;
		background: #111827;
		border: 1px solid #1a2035;
		border-radius: 10px;
		color: inherit;
		transition: border-color 0.15s, box-shadow 0.15s, background 0.15s;
		margin-bottom: 0.75em;
	}
	.post-card:hover {
		border-color: #0678be;
		background: #131e30;
		box-shadow: 0 0 0 1px rgba(6,120,190,0.15), 0 4px 16px rgba(6,120,190,0.08);
		color: inherit;
	}
	.post-date {
		font-size: 0.78em;
		color: #8899b8;
		letter-spacing: 0.02em;
	}
	.post-card h3 {
		margin: 0;
		font-size: 1.35em;
		color: #fff;
		font-weight: 700;
		line-height: 1.3;
	}
	.post-card p {
		margin: 0;
		max-width: 70ch;
		font-size: 0.98em;
		color: #8899b8;
		line-height: 1.6;
	}
	.read-more {
		font-size: 0.82em;
		color: #0e90d9;
		margin-top: 0.25em;
		font-weight: 500;
	}
	.post-card:hover .read-more {
		color: #2dd4bf;
	}

	.empty {
		color: #7c8db0;
		font-style: italic;
		text-align: center;
		padding: 3em 0;
	}
</style>
